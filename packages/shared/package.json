{
  "name": "@dar/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain logic, validation schemas, API types, branding and translations for Dar",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "react-native": "./src/domain/index.ts",
      "default": "./dist/domain/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "@types/node": "^22.18.6"
  }
}
