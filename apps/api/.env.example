# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API from a browser (admin dashboard).
CORS_ORIGINS=http://localhost:3000
# Set when running behind a reverse proxy / load balancer so client IPs are correct.
TRUST_PROXY=false

DATABASE_URL=postgresql://dar:dar_local_dev@localhost:5432/dar
# Used by `pnpm db:check` to verify migrations match schema.prisma.
SHADOW_DATABASE_URL=postgresql://dar:dar_local_dev@localhost:5432/dar_shadow
TEST_DATABASE_URL=postgresql://dar:dar_local_dev@localhost:5432/dar_test

# 64+ random characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-characters
TOKEN_HASH_PEPPER=change-me-dev-only-pepper-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS_MOBILE=60
REFRESH_TOKEN_TTL_HOURS_ADMIN=12

# Storage: "s3" (MinIO locally, any S3-compatible provider in production) or "local" (dev only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dar-private
S3_ACCESS_KEY_ID=dar_minio
S3_SECRET_ACCESS_KEY=dar_minio_local_dev
S3_FORCE_PATH_STYLE=true
# Public base URL of the API, used by the local storage driver's signed URLs.
PUBLIC_API_URL=http://localhost:4000
SIGNED_URL_TTL_SECONDS=900

# Push notifications through Expo's push service. When false, notifications are
# stored in-app and their push status is recorded as UNCONFIGURED (never "sent").
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Email for password resets. "console" prints the reset link in development only.
EMAIL_DRIVER=console
EMAIL_FROM=Dar <no-reply@example.com>
SMTP_URL=
ADMIN_WEB_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=dar

# Phone OTP is optional and unconfigured by default. Phone numbers are never
# marked as verified without a real provider.
OTP_PROVIDER=none

# Optional OCR assistance for spotting contact details inside photos.
OCR_PROVIDER=none

# Jobs (monthly obligations, reminders). Disable on all but one instance.
JOBS_ENABLED=true
