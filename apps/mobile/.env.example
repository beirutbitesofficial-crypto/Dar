# Public values only — anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Use your computer's LAN IP (not localhost) when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Set after `eas init`
EAS_PROJECT_ID=
# Optional: Google Maps keys for the approximate-location map view on Android/iOS release builds
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
