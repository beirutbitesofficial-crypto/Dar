{
  "name": "dar",
  "private": true,
  "version": "0.1.0",
  "description": "Dar / \u062f\u0627\u0631 \u2014 managed real estate brokerage platform for Lebanon (mobile app, admin dashboard, API)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @dar/api dev",
    "dev:admin": "pnpm --filter @dar/admin dev",
    "dev:mobile": "pnpm --filter @dar/mobile start",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:migrate": "pnpm --filter @dar/api prisma:migrate:deploy",
    "db:check": "pnpm --filter @dar/api prisma:check",
    "db:seed": "pnpm --filter @dar/api seed",
    "build": "pnpm -r --filter=!@dar/mobile build",
    "build:api": "npm --prefix packages/shared run build && npm --prefix apps/api run build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:sql": "bash scripts/test-sql.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:sql && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "globals": "^16.4.0",
    "playwright": "^1.55.0"
  }
}
